FROM ghcr.io/astral-sh/uv:{{ cookiecutter.uv_version }}-python{{ cookiecutter.python_majmin }}-trixie-slim

ARG DEBIAN_FRONTEND=noninteractive

ARG PACKAGE_NAME
ARG DOCKER_MOUNT_POINT
ARG DOCKER_CONTAINER_PORT

ENV CONTAINER_PORT="${DOCKER_CONTAINER_PORT}"

RUN apt-get -y update && \
    apt-get -y install --no-install-recommends \
        bat \
        btop \
        curl \
        git \
        less \
        libpq-dev \
        make \
        procps \
        ripgrep \
        tree \
    && \
    apt-get clean

WORKDIR "${DOCKER_MOUNT_POINT}"


# ==
# uv
# --

# Disable output buffering to deliver log records to the container logs immediately.
ENV PYTHONUNBUFFERED=1

# Keep the container's virtual environment outside the mounted project directory to
# avoid a collision with the host's `.venv` in the mount.
ENV UV_PROJECT_ENVIRONMENT="{{ cookiecutter.docker_prefix }}/.venv"

# Copy packages from the uv cache instead of hard-linking them: the build cache mount
# and the virtual environment are on different filesystems.
ENV UV_LINK_MODE=copy

# Compile bytecode at install time.
ENV UV_COMPILE_BYTECODE=1

# Add project sources and the minimum set of files required for the build system.
ADD src "${DOCKER_MOUNT_POINT}/src"
ADD \
    .gitignore \
    .python-version \
    LICENSE \
    Makefile \
    README.rst \
    pyproject.toml \
    uv.lock \
"${DOCKER_MOUNT_POINT}/"

RUN make venv
RUN --mount=type=cache,target=/root/.cache/uv \
    make install


ENTRYPOINT ["/bin/bash"]
