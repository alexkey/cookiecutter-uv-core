{
    "name": "FooBar-baz",
    "service_name": "{{ cookiecutter.name | lower }}",
    "repo_name": "{{ cookiecutter.service_name | replace('-', '_') }}",
    "env_prefix": "{{ cookiecutter.name.split('-')[0].split('_')[0] | upper }}_",

    "version": "0.1.0",
    "brief": "Just foo bar",
    "description": "A Python project template for Cookiecutter that sets up a development environment\nwith uv for dependency management.\n\nThe template includes tools and configurations for building, testing, packaging, and\ndistributing Python applications, and for running them in Docker. It integrates\nquality assurance tools, testing infrastructure, dependency analysis, and container\nbuilds for several platforms.",
    "author_name": "John Doe",
    "author_email": "john.doe@example.com",
    "url": "https://example.com",
    "repository": "https://github.com/{{ cookiecutter.name }}/{{ cookiecutter.service_name }}",
    "license": "BSD-3-Clause",
    "year": "{% now 'local', '%Y' %}",

    "uv_version": "0.13.7",
    "python_version": "3.15.2",
    "python_majmin": "{{ cookiecutter.python_version.rsplit('.', 1)[0] }}",

    "docker_build_platform": "linux/amd64",
    "docker_compose_name": "{{ cookiecutter.service_name }}",
    "docker_prefix": "/opt/{{ cookiecutter.service_name }}",

    "redis_image_tag": "8.10.3-alpine",
    "postgres_image_tag": "18.6-alpine",
    "postgres_user": "database",

    "_copy_without_render": [
        ".agents/skills/*.md",
        ".agents/skills/*.yaml"
    ]
}
